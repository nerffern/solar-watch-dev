# ── solarwatch-powerflow.service ──────────────────────────────────────────────
# Systemd unit for the SolarWatch live power flow web app (port 8765).
# Runs independently of the collector — can be restarted without affecting data collection.
#
# Install: sudo cp solarwatch-powerflow.service /etc/systemd/system/
#          sudo systemctl daemon-reload
#          sudo systemctl enable --now solarwatch-powerflow
#
# View logs: sudo journalctl -u solarwatch-powerflow -f

[Unit]
Description=SolarWatch Power Flow Web App
After=network-online.target solarwatch.service
Wants=network-online.target

[Service]
Type=simple
User=solarwatch
Group=solarwatch
WorkingDirectory=/opt/solarwatch
ExecStart=/opt/solarwatch/venv/bin/python3 powerflow_server.py
Restart=always
RestartSec=10
TimeoutStopSec=15
# Kill the entire process group on stop — prevents orphaned uvicorn workers
# holding the port after a failed restart cycle
KillMode=mixed
StandardOutput=journal
StandardError=journal
SyslogIdentifier=solarwatch-powerflow

# Shares the same env file as the collector
EnvironmentFile=/opt/solarwatch/.env

[Install]
WantedBy=multi-user.target
